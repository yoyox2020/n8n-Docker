# MST Agent Service — copy nilai ke deploy/phase-0/.env
# DATABASE_URL dioverride oleh docker-compose, tidak perlu diset manual

# Mistika AI (LLM provider)
MISTIKA_BASE_URL=https://misstika.mst.co.id/llm-router
MISTIKA_API_KEY=your-api-key-here
MISTIKA_CHAT_PATH=/chat/streamchat
MISTIKA_AUTH_HEADER=x-api-key

# n8n instance (pada mstworkflow network yang sama)
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=

# Service
DEBUG=false
