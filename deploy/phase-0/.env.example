# Asuralab Phase 0 — Environment Template
# Copy to .env and fill in values, or run: ./scripts/provision.sh
# NEVER commit .env to git.

# --- Owner ---
OWNER_EMAIL=admin@asuralab.io
OWNER_PASSWORD_HASH=          # bcrypt hash — generated by provision script
OWNER_FIRST_NAME=Admin
OWNER_LAST_NAME=Asuralab

# --- Database ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=            # generated by provision script
POSTGRES_DB=n8n

# --- n8n ---
N8N_ENCRYPTION_KEY=           # generated by provision script
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678
N8N_LOG_LEVEL=info
